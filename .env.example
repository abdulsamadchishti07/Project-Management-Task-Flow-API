# ==============================================================================
# TaskFlow API - Environment Variables Template
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
# ==============================================================================

# Database Configuration
# Local development (SQLite): sqlite:///./dev.db
# PostgreSQL / Docker Compose: postgresql://postgres:postgres@localhost:5432/project_managment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_managment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=project_managment

# JWT Authentication
# Generate a cryptographically secure secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_key_generated_via_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Delivery (SMTP)
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=your_smtp_app_password_here
DEFAULT_FROM_EMAIL=notifications@example.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Redis Cache & Rate Limiting
# Local development: redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
